# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL connection (local install with PostGIS extension enabled)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_evac_planner
DB_USER=postgres
DB_PASSWORD=your_password_here

# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_key_here

# How often the background job polls the weather API and refreshes
# road risk weights, in minutes
WEATHER_POLL_INTERVAL_MINUTES=15

# Default admin dashboard account (used by `python -m db.seed_admin`).
# Change these before any real deployment — seed_admin.py will warn you
# if you leave the password at its fallback value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
